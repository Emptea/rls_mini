{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "RLS Mini: Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/src",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=/share/toolchain.cmake",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": []
        },
        {
            "label": "RLS Mini: Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "install",
                "-j3"
            ],
            "dependsOn": "RLS Mini: Configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "RLS Mini: Copy to mini2",
            "type": "process",
            "command": "scp",
            "args": [
                "${workspaceFolder}/bin/rls_mini",
                "mini2:~/rls_mini/bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "RLS Mini: Copy to mini",
            "type": "process",
            "command": "scp",
            "args": [
                "${workspaceFolder}/bin/rls_mini",
                "mini:~/rls_mini/bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "RLS Mini: Copy config to mini2",
            "type": "process",
            "command": "scp",
            "args": [
                "${workspaceFolder}/config/mini.ini",
                "${workspaceFolder}/config/tx_gainon.txt",
                "${workspaceFolder}/config/tx_dac.txt",
                "${workspaceFolder}/config/rx_en.txt",
                "${workspaceFolder}/config/tx_coeffs.csv",
                "mini2:~/rls_mini/bin/"
            ],
            "problemMatcher": []
        },
        {
            "label": "RLS Mini: Copy config to mini",
            "type": "process",
            "command": "scp",
            "args": [
                "${workspaceFolder}/config/mini.ini",
                "${workspaceFolder}/config/tx_gainon.txt",
                "${workspaceFolder}/config/tx_dac.txt",
                "${workspaceFolder}/config/rx_en.txt",
                "${workspaceFolder}/config/tx_coeffs.csv",
                "mini:~/rls_mini/bin/"
            ],
            "problemMatcher": []
        }
    ]
}